---
const industries = [
  {
    title: "Home Service Pros",
    description: "Reach high-value homeowners looking for reliable contractors, remodelers, and specialists.",
    icon: "🏠",
    class: "md:col-span-2 md:row-span-1",
  },
  {
    title: "Healthcare & Wellness",
    description: "Build local trust for clinics, private practices, and wellness brands.",
    icon: "🩺",
    class: "md:col-span-1 md:row-span-1",
  },
  {
    title: "Retail & Jewelers",
    description: "Highlight premium products and drive foot traffic to your physical store.",
    icon: "💎",
    class: "md:col-span-1 md:row-span-1",
  },
  {
    title: "Schools & Community",
    description: "Connect educational programs and sponsorships directly with local families.",
    icon: "🎓",
    class: "md:col-span-2 md:row-span-1",
  },
  {
    title: "Hospitality & Dealerships",
    description: "Stand out in competitive markets with memorable, high-converting branding.",
    icon: "🚘",
    class: "md:col-span-3 md:row-span-1",
  },
];
---

<section class="py-16 px-4 max-w-6xl mx-auto">
  <div class="text-center mb-12">
    <p class="text-xs uppercase tracking-widest text-[#B58D50] font-semibold mb-2">Tailored Reach</p>
    <h2 class="text-3xl md:text-4xl font-serif text-white font-bold">Industries We Scale</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {industries.map((item) => (
      <div 
        class={`bento-card group relative overflow-hidden rounded-2xl bg-[#1A1A1C] border border-white/10 p-6 
        transition-all duration-500 ease-out 
        hover:-translate-y-1.5 hover:border-[#B58D50]/60 
        hover:shadow-[0_12px_30px_-10px_rgba(181,141,80,0.25)] ${item.class}`}
      >
        <!-- Background Glow Element -->
        <div 
          class="glow-effect pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl"
          style="background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(181, 141, 80, 0.15), transparent 40%);"
        ></div>

        <!-- Ambient Bottom Corner Glow -->
        <div class="absolute -right-8 -bottom-8 w-28 h-28 bg-[#B58D50]/10 rounded-full blur-xl group-hover:bg-[#B58D50]/25 group-hover:scale-125 transition-all duration-700 ease-out pointer-events-none"></div>

        <!-- Content Structure -->
        <div class="relative z-10 flex flex-col justify-between h-full">
          <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 text-2xl mb-6 group-hover:scale-110 group-hover:border-[#B58D50]/40 transition-all duration-300">
            {item.icon}
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-[#B58D50] transition-colors duration-300">
              {item.title}
            </h3>
            <p class="text-sm text-gray-400 leading-relaxed group-hover:text-gray-300 transition-colors duration-300">
              {item.description}
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Client-side script for interactive mouse tracking spot-light effect -->
<script>
  const handleMouseMove = (e: MouseEvent) => {
    const cards = document.querySelectorAll<HTMLElement>('.bento-card');
    cards.forEach((card) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
    });
  };

  document.addEventListener('mousemove', handleMouseMove);
</script>
