---
const services = [
  {
    title: "Brand Strategy & Positioning",
    problem: "Blending in and competing strictly on price.",
    benefit: "A clear, honest roadmap defining your brand identity and competitive edge so you stand out effortlessly.",
    icon: "🎯"
  },
  {
    title: "Community & Market Visibility",
    problem: "Marketing dollars wasted on generic, irrelevant audiences.",
    benefit: "Direct placement in front of high-value homeowners and families through print, digital, and local sponsorships.",
    icon: "📍"
  },
  {
    title: "Growth & Revenue Strategy",
    problem: "Generating attention without knowing how to convert it into income.",
    benefit: "A hands-on action plan that turns visibility into sales—proven to expand client reach by 50% and boost revenue.",
    icon: "📈"
  }
];
---

<section class="py-20 px-4 max-w-6xl mx-auto text-white">
  <!-- Section Header -->
  <div class="text-center max-w-3xl mx-auto mb-16">
    <p class="text-xs uppercase tracking-widest text-[#B58D50] font-semibold mb-2">What I Offer</p>
    <h2 class="text-4xl font-serif font-bold mb-4">Services Built for Impact</h2>
    <p class="text-gray-400 text-sm">Every service is delivered with care, professionalism, and a commitment to the people I serve.</p>
  </div>

  <!-- Services Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
    {services.map((s) => (
      <div class="p-8 rounded-2xl bg-[#1A1A1C] border border-white/10 hover:border-[#B58D50]/50 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="text-3xl mb-4">{s.icon}</div>
          <h3 class="text-xl font-bold mb-3 text-white">{s.title}</h3>
          <p class="text-sm text-gray-300 leading-relaxed mb-4">{s.benefit}</p>
        </div>
        <div class="pt-4 border-t border-white/10 text-xs text-gray-400">
          <span class="text-[#B58D50] font-semibold">Solves:</span> {s.problem}
        </div>
      </div>
    ))}
  </div>

  <!-- Interactive Campaign & Print Pricing Configurator -->
  <div class="bg-[#1D1D1F] border border-white/10 rounded-3xl p-8 md:p-12 shadow-2xl">
    <div class="text-center mb-10">
      <h3 class="text-2xl md:text-3xl font-serif font-bold mb-2">Campaign & Print Pricing Estimator</h3>
      <p class="text-gray-400 text-sm">Configure your ad layout, digital enhancements, and target neighborhood market.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Step 1: Print Ad Size -->
      <div class="space-y-3">
        <label class="block text-xs uppercase tracking-wider text-[#B58D50] font-semibold">1. Select Print Ad Size</label>
        <div class="grid grid-cols-1 gap-2" id="ad-size-options">
          <button data-value="1/8" class="opt-btn py-2.5 px-4 rounded-xl border border-white/10 bg-white/5 text-sm text-left hover:border-[#B58D50] active">1/8 Page</button>
          <button data-value="1/4" class="opt-btn py-2.5 px-4 rounded-xl border border-white/10 bg-white/5 text-sm text-left hover:border-[#B58D50]">1/4 Page</button>
          <button data-value="1/3" class="opt-btn py-2.5 px-4 rounded-xl border border-white/10 bg-white/5 text-sm text-left hover:border-[#B58D50]">1/3 Page</button>
          <button data-value="1/2" class="opt-btn py-2.5 px-4 rounded-xl border border-white/10 bg-white/5 text-sm text-left hover:border-[#B58D50]">1/2 Page</button>
          <button data-value="Full" class="opt-btn py-2.5 px-4 rounded-xl border border-white/10 bg-white/5 text-sm text-left hover:border-[#B58D50]">Full Page</button>
        </div>
      </div>

      <!-- Step 2: Digital & Reviews Package -->
      <div class="space-y-3">
        <label class="block text-xs uppercase tracking-wider text-[#B58D50] font-semibold">2. Select Digital / Review Tier</label>
        <div class="grid grid-cols-1 gap-2" id="digital-tier-options">
          <button data-value="Listings" class="tier-btn py-2.5 px-4 rounded-xl border border-white/10 bg-white/5 text-sm text-left hover:border-[#B58D50] active">Listings</button>
          <button data-value="Listings + Reviews" class="tier-btn py-2.5 px-4 rounded-xl border border-white/10 bg-white/5 text-sm text-left hover:border-[#B58D50]">Listings + Reviews</button>
          <button data-value="Reviews Upgrade" class="tier-btn py-2.5 px-4 rounded-xl border border-white/10 bg-white/5 text-sm text-left hover:border-[#B58D50]">Reviews (Upgrade)</button>
        </div>
      </div>

      <!-- Step 3: Target Community & Summary -->
      <div class="space-y-4 flex flex-col justify-between bg-white/5 p-6 rounded-2xl border border-white/10">
        <div>
          <label class="block text-xs uppercase tracking-wider text-[#B58D50] font-semibold mb-2">3. Target Market</label>
          <select id="market-select" class="w-full bg-[#121212] border border-white/20 rounded-xl py-2.5 px-3 text-sm text-white focus:outline-none focus:border-[#B58D50]">
            <option value="Broussard">Neighbors of Broussard (Broussard, LA)</option>
            <option value="Youngsville">Neighbors of Youngsville, LA</option>
            <option value="Lafayette">Neighbors of Lafayette, LA</option>
          </select>
        </div>

        <div class="border-t border-white/10 pt-4 mt-4">
          <div class="text-xs text-gray-400 mb-1">Selected Configuration:</div>
          <div id="summary-text" class="text-sm font-semibold text-white mb-4">1/8 Page • Listings • Broussard, LA</div>
          <a href="#contact" class="block w-full text-center py-3 rounded-xl bg-[#B58D50] text-black font-bold text-sm hover:bg-[#c69d5c] transition-colors">
            Request Quote for Campaign
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .opt-btn.active, .tier-btn.active {
    background-color: rgba(181, 141, 80, 0.2);
    border-color: #B58D50;
    color: #FFF;
  }
</style>

<script>
  // Simple state toggle logic for configurator UI
  const setupGroup = (selector, stateKey) => {
    const buttons = document.querySelectorAll(selector);
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        updateSummary();
      });
    });
  };

  setupGroup('.opt-btn');
  setupGroup('.tier-btn');

  const marketSelect = document.getElementById('market-select');
  if (marketSelect) marketSelect.addEventListener('change', updateSummary);

  function updateSummary() {
    const activeSize = document.querySelector('.opt-btn.active')?.getAttribute('data-value') || '1/8';
    const activeTier = document.querySelector('.tier-btn.active')?.getAttribute('data-value') || 'Listings';
    const activeMarket = (marketSelect as HTMLSelectElement)?.value || 'Broussard';

    const summary = document.getElementById('summary-text');
    if (summary) {
      summary.textContent = `${activeSize} Page • ${activeTier} • ${activeMarket}, LA`;
    }
  }
</script>
